# 复制为 .env 并填入真实值
# ===== 数据库 =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=news_app
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ===== 服务 =====
# CORS 白名单，逗号分隔。留空则用开发默认值（localhost:5173 / 127.0.0.1:5173，含 5174）
# 部署时务必改成前端真实域名，不要再用 *
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 登录 token 存在 httpOnly cookie 里。上了 HTTPS 必须置 true，
# 否则 cookie 会以明文在 http 上传输；本地 http 调试必须是 false，否则浏览器不保存
COOKIE_SECURE=false
# 阅读量增量回写数据库的间隔（秒）
VIEW_FLUSH_INTERVAL=30
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
# 连接/读超时（秒）。必须设小：Redis 不可用时要快速降级查库，而不是把请求卡住
REDIS_CONNECT_TIMEOUT=0.5
REDIS_SOCKET_TIMEOUT=0.5

# ===== 大模型（OpenAI 兼容接口）=====
AI_CHAT_URL=https://your-llm-gateway/v1/chat/completions
AI_API_KEY=your-api-key
AI_MODEL=qwen3.7-plus
AI_TIMEOUT=120
# 允许客户端通过请求体切换的模型，逗号分隔；留空表示只能用 AI_MODEL
AI_ALLOWED_MODELS=
